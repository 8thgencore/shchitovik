# Caddy site for «Щитовик»: Flutter Web build and the price catalog.
# Alternative to deploy/nginx/shchitovik.conf with the same layout and headers.
# Domain shchitovik.ru; Caddy obtains and renews TLS certificates itself.
# Layout on the server (deployed by CI, see deploy/README.md):
#   /var/www/shchitovik/web/      — Flutter Web build (app/build/web)
#   /var/www/shchitovik/catalog/  — catalog files (tools/catalog/publish_catalog.py)

shchitovik.ru {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Price catalog for the mobile apps and the web app.
	handle_path /catalog/* {
		root * /var/www/shchitovik/catalog
		header {
			Cache-Control "no-cache"
			Access-Control-Allow-Origin "*"
			Cross-Origin-Resource-Policy "cross-origin"
		}
		file_server
	}

	handle {
		root * /var/www/shchitovik/web

		# Cross-origin isolation enables OPFS storage for drift (SharedArrayBuffer);
		# without it the app falls back to IndexedDB.
		header {
			Cross-Origin-Opener-Policy "same-origin"
			Cross-Origin-Embedder-Policy "require-corp"
		}

		# `route` keeps the written order, so the entry-point matcher sees the path after
		# try_files: go_router routes served as index.html are not cached either.
		route {
			# Single-page app: unknown paths are routes of go_router.
			try_files {path} /index.html

			# Entry points must never be cached: they reference the current build.
			@entry path / /index.html /flutter_service_worker.js
			header @entry Cache-Control "no-cache"

			# sqlite3.wasm gets Content-Type application/wasm from Caddy's built-in types.
			file_server
		}
	}
}
